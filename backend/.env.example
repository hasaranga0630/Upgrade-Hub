# Upgrade Hub - Backend Environment Configuration Template
PORT=5000
NODE_ENV=production

# MongoDB Atlas or local MongoDB connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/upgrade_hub?retryWrites=true&w=majority

# JWT Token Secret for signing user sessions (use a 64+ char random string in production)
JWT_SECRET=your_super_secret_jwt_key_here

# Allowed Frontend Origins for CORS (comma separated if multiple)
FRONTEND_ORIGIN=http://localhost:3000,https://upgrade-hub.vercel.app,https://your-domain.com
